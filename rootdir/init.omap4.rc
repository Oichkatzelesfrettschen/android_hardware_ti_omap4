on boot
    # Hardware tunables
    chown root system /sys/devices/platform/omapdss/manager0/cpr_coef
    chown root system /sys/devices/platform/omapdss/manager0/cpr_enable
    chmod 0664 /sys/devices/platform/omapdss/manager0/cpr_coef
    chmod 0664 /sys/devices/platform/omapdss/manager0/cpr_enable
    restorecon /sys/devices/platform/omapdss/manager0/cpr_coef
    restorecon /sys/devices/platform/omapdss/manager0/cpr_enable

    # The power HAL (user system) boosts the MPU through the interactive
    # governor and tunes it at init.
    chown system system /sys/devices/system/cpu/cpufreq/interactive/boostpulse
    chown system system /sys/devices/system/cpu/cpufreq/interactive/timer_rate
    chown system system /sys/devices/system/cpu/cpufreq/interactive/min_sample_time
    chown system system /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq
    chown system system /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load
    chown system system /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay
    chown system system /sys/devices/system/cpu/cpufreq/interactive/target_loads
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/boostpulse
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/timer_rate
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/min_sample_time
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/target_loads
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq

on fs
    # Load PVR module
    insmod /vendor/lib/modules/pvrsrvkm.ko
    insmod /vendor/lib/modules/omaplfb.ko

    # sgxfreq's burst governor creates its burst/ nodes when selected; the
    # power HAL opens a GPU boost window through boost_ms and caps the GPU
    # through frequency_limit while the screen is off.
    write /sys/devices/platform/omap/pvrsrvkm.0/sgxfreq/governor burst
    chown system system /sys/devices/platform/omap/pvrsrvkm.0/sgxfreq/burst/boost_ms
    chown system system /sys/devices/platform/omap/pvrsrvkm.0/sgxfreq/frequency_limit
    chmod 0664 /sys/devices/platform/omap/pvrsrvkm.0/sgxfreq/burst/boost_ms
    chmod 0664 /sys/devices/platform/omap/pvrsrvkm.0/sgxfreq/frequency_limit

service pvrsrvinit /vendor/bin/pvrsrvinit
    class core
    user root
    group root
    oneshot
